# ToneOp Workspace — copy to .env.local for local development.

# Required. Django Workspace API (Phase 1).
# Use /api only if you want the leftover Next.js mock BFF routes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Optional. Public asset CDN / S3 bucket.
NEXT_PUBLIC_ASSETS_URL=https://assets.toneop.net

# Optional. Browser tab title prefix.
NEXT_PUBLIC_APP_NAME=ToneOp Workspace
