# ToneOp Workspace — copy to .env.local for local development.
# Frontend-only Phase 1: the API base points at this Next.js app's BFF routes.

# Required. Same-origin BFF until the real Workspace API exists.
# Use /api locally so the port does not matter. Use a full URL in production.
NEXT_PUBLIC_API_BASE_URL=/api

# Optional. Public asset CDN / S3 bucket.
NEXT_PUBLIC_ASSETS_URL=https://assets.toneop.net

# Optional. Browser tab title prefix.
NEXT_PUBLIC_APP_NAME=ToneOp Workspace
